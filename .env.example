# dev: /api é proxiado pelo Vite (ver vite.config.ts) para http://localhost:3000/api
# prod: deploy define a URL absoluta (ex: https://api.tagravado.com/api)
VITE_API_URL="/api"

# toggle global mock/API real. default = true (mocks locais em src/lib/api/mocks).
# em staging/production o deploy deve setar explicitamente como "false".
VITE_USE_MOCKS="true"
