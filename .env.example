# dev: /api é proxiado pelo Vite (ver vite.config.ts) para http://localhost:3000/api
# prod: deploy define a URL absoluta (ex: https://api.tagravado.com/api)
VITE_API_URL="/api"

# toggle global mock/API real. default = false (API real via proxy Vite).
# domínios sem endpoint no backend (cameras, patrocinadores) ficam em mock
# via ENDPOINT_READY=false nos respectivos stubs, independente desta flag.
VITE_USE_MOCKS="false"
